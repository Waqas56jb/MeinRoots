# Base URL of the MeinRoots API.
#
# Local development against a local API:
VITE_API_URL=http://localhost:4000
#
# Deployed behind the same nginx that serves this build, leave it empty —
# requests then go to /api on the same origin, which also means the session
# cookies are first-party:
# VITE_API_URL=
#
# Front end on Vercel, API on its own host — must be https, or the browser
# blocks it as mixed content:
# VITE_API_URL=https://api.meinroots.com
