# ---------------------------------------------------------------------------
# MeinRoots API — copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres. On the server the database only listens on localhost, so this
# connection string is not reachable from the internet — that is deliberate.
DATABASE_URL=postgres://meinroots_app:CHANGE_ME@127.0.0.1:5432/meinroots
DB_POOL_MAX=10

# Sign the access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Cookies. COOKIE_SECURE must be true once the API is behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set when the API and the front end share a registrable domain, e.g. .meinroots.de
# COOKIE_DOMAIN=

# Front-end origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:5173,https://meinroots-client.vercel.app
CORS_ALLOW_VERCEL_PREVIEWS=true

# Where uploaded CVs are written (relative to server/). The Contabo box has
# 200 GB of SSD, which is where this lives in production.
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=10485760

# OpenAI. Without this the API still runs, but analysis jobs fail.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2

# Background worker. Runs inside the API process by default.
WORKER_IN_PROCESS=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000

# Security
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=8
LOGIN_LOCK_MINUTES=15
RESET_TTL_MINUTES=60

# Used to build password-reset links.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Outgoing email.
#
# Leave SMTP_HOST empty and the platform still works: messages are recorded as
# `skipped` and their links written to the log, so a verification link can be
# delivered by hand while credentials are pending.
#
# The mailbox is at Hostinger, which is where the MX for meinroots.de points
# and the only sender the domain's SPF record authorises. Sending this address
# through Gmail fails twice: the mailbox is not a Google account so AUTH is
# refused, and mail that did get out would fail SPF at the receiving end and be
# filed as spam. SMTP_PASS is the mailbox password exactly as issued, including
# any punctuation — it is not a Google app password and must not be reformatted.
# Keep it in this file only: never in the client, admin or recruiter builds, and
# never in a commit.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=recruiting@meinroots.de
SMTP_PASS=CHANGE_ME

# The platform's own address. Every template inherits it; none sets a sender of
# its own, so this is the single place the company mailbox is written down.
MAIL_FROM=MeinRoots <recruiting@meinroots.de>
MAIL_REPLY_TO=recruiting@meinroots.de

# How long a verification link stays valid.
VERIFY_TTL_HOURS=48
